# 临时草稿 / 中转工作区（不入库）
tmp/

# Rust build artefacts. The target dir is redirected to ext4 by
# .cargo/config.toml (D2); `target/` is ignored anyway so a build run with
# the redirect removed cannot accidentally commit gigabytes.
target/

# Local databases and their WAL sidecars. A .db here would be candidate data.
*.db
*.db-wal
*.db-shm
*.db.bak
*.db.bak-wal
*.db.bak-shm

# Local environment / credentials. Never commit an AI key.
.env
.env.*
!.env.example

# Python bytecode. The scripts/ helpers are imported directly by reviewers
# and by the audit commands, which leaves __pycache__ directories behind.
__pycache__/
*.py[cod]

# The OCR engine's model cache is created at runtime; never commit it.
crates/*/models/

# Frontend (F0-1: migrated from the baseline repo per ADR-0007). Build
# artefacts and dependency trees never enter version control.
frontend/node_modules/
frontend/dist/
frontend/coverage/

# The Tauri host's staged bundle (P1: filled by the packaging flow, never
# committed; the tauri-build resource check needs the directories present).
desktop/tauri-host/bundle-resources/*
!desktop/tauri-host/bundle-resources/ui/
desktop/tauri-host/target/
desktop/tauri-host/gen/
